# ── Secrets / credentials ─────────────────────────────────────────────
# Never commit env files (real creds live here or in ~/.informatica-mcp.env)
.env
.env.*
*.env
!*.env.example

# Private keys / key material of any kind
*.p8
*.pem
*.key
*.pkcs8
*.ppk
id_rsa*
id_ed25519*
*_rsa
*_ed25519

# ── Connection plan files & inventories (contain infra detail / secrets) ─
# The migration plan files read on the box (may hold key paths / passphrases)
connection_key_migration.json
*_migration*.json
*migration_*.json
snowflake_connection_update*.json
role_migration*.json
my_migration.json
TEST_*.json
# Keep a sanitized template if you want one, e.g. connection_key_migration.example.json
!*.example.json

# Connection inventories (real connection ids, users, JDBC params)
snowflake_connparams.json
snowflake_connparams.csv
*_connparams.*

# ── Monitor runtime state (not source) ───────────────────────────────
monitor_state.json
failures.jsonl
audit.log

# ── Python / OS cruft ─────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.DS_Store
