[Unit]
Description=Daily 08:00 Central check for the IDMC weekly failure digest

[Timer]
# Fires DAILY, not just Mondays: the script posts only when the last completed
# week hasn't been posted yet. Monday is the normal post; Tuesday onward is
# the automatic retry if Monday's post failed or the box was down.
OnCalendar=*-*-* 08:00:00 America/Chicago
Persistent=true
Unit=weekly-digest.service

[Install]
WantedBy=timers.target
